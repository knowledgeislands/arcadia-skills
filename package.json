{
  "name": "@knowledgeislands/ki-agentic-harness",
  "description": "Knowledge Islands agentic harness — canonical home for Agent Skills, Agents, MCP servers, and Evals across the Knowledge Islands ecosystem.",
  "version": "1.0.0",
  "author": "kris@kris.me.uk",
  "bugs": {
    "url": "https://github.com/knowledgeislands/ki-agentic-harness/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^17.1.0",
    "markdownlint-cli2": "^0.23.1",
    "prettier": "^3.9.5",
    "syncpack": "^15.3.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://github.com/knowledgeislands/ki-agentic-harness#readme",
  "keywords": [
    "agent-skills",
    "anthropic",
    "claude",
    "claude-code",
    "knowledge-islands",
    "multi-runtime",
    "skills"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{ts,js,mjs,json,jsonc}": "bunx @biomejs/biome check --write --no-errors-on-unmatched",
    "*.md": [
      "bunx prettier --write",
      "bunx markdownlint-cli2 --no-globs"
    ]
  },
  "packageManager": "bun@1.3.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/knowledgeislands/ki-agentic-harness.git"
  },
  "scripts": {
    "clean": "rm -rf node_modules",
    "ki:binding:build-plugin": "bun skills/environment/ki-binding/scripts/build-plugin.ts",
    "ki:eval": "bun evals/harness.ts",
    "prepare": "husky",
    "test": "bun test --isolate --max-concurrency=1 ./skills ./hooks && bun skills/keystone/ki-bootstrap/scripts/internal/repo-bootstrap/skill-graph.ts --check --check-doc docs/guides/user/skills.md && bun skills/keystone/ki-bootstrap/scripts/internal/repo-bootstrap/skill-help.ts --check"
  },
  "type": "module"
}
