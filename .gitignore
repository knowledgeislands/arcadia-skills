# Dependency directories
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor directories and files
.idea/
.vscode/
*.swp
*.swo

# Claude Code local settings
.claude/settings.local.json

# OS specific files
.DS_Store
Thumbs.db

# Logs
logs
*.log
*.tsbuildinfo

# Eval outputs — regeneratable run results (the harness + scenarios are the source
# of truth; the live summary lives in evals/README.md). Re-run with `bun run eval`.
evals/results/

# KI governance working artifacts — derived audit/conform reports (regenerated each
# run via a checker's --report).
.ki/audits/
.ki/conform/

# Project-local skills and agents are generated by ki-bootstrap, not committed.
# The repo-local ki-self source is the one tracked exception: .agents/skills/ki-self/.
.claude/skills/*
.claude/agents/

# Generated project-local links (ki-bootstrap) — never committed
.agents/skills/*
!.agents/skills/ki-self/
!.agents/skills/ki-self/**
