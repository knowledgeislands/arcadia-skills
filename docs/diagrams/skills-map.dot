// Canonical source for the harness skills map. DOT is authoritative; regenerate
// skills-map.svg with: dot -Tsvg skills-map.dot -o skills-map.svg
//
// Flow is deliberately general-to-specialised, left-to-right. Colour and the
// second line of each node identify the skill family; clusters would add a
// competing spatial hierarchy and obscure the dependency flow.
digraph skills_map {
  graph [
    bgcolor="#fbfcfe"
    fontname="Helvetica"
    fontsize=20
    label=<
      <b>Knowledge Islands skills</b><br/>
      <font point-size="11">Foundations on the left · specialised capabilities on the right · colour identifies the family · solid arrows are declared prerequisites · dashed arrows are contextual relationships</font>
    >
    labelloc=t
    margin=0.25
    nodesep=0.32
    rankdir=LR
    ranksep=0.85
    splines=ortho
  ]

  node [
    color="#9aaabd"
    fontcolor="#172033"
    fontname="Helvetica"
    fontsize=11
    margin="0.14,0.1"
    penwidth=1.2
    shape=box
    style="rounded,filled"
  ]

  edge [
    arrowsize=0.7
    color="#8192a8"
    fontcolor="#52647a"
    fontname="Helvetica"
    fontsize=9
    penwidth=1.1
  ]

  // Foundation and repository roots.
  bootstrap [fillcolor="#d9f0e2", label=< <b>ki-bootstrap</b><br/><font point-size="9">Keystone</font><br/><font point-size="9">user setup · activation guidance</font> >]
  repo [fillcolor="#d9f0e2", label=< <b>ki-repo</b><br/><font point-size="9">Keystone</font><br/><font point-size="9">repository identity · baseline</font> >]

  // General standards and shared shapes.
  authoring [fillcolor="#feead2", label=< <b>ki-authoring</b><br/><font point-size="9">Governance</font><br/><font point-size="9">writing conventions</font> >]
  decisions [fillcolor="#feead2", label=< <b>ki-decision-records</b><br/><font point-size="9">Governance</font><br/><font point-size="9">decision records</font> >]
  engineering [fillcolor="#feead2", label=< <b>ki-engineering</b><br/><font point-size="9">Governance</font><br/><font point-size="9">toolchain · tests</font> >]
  features [fillcolor="#feead2", label=< <b>ki-feature-definitions</b><br/><font point-size="9">Governance</font><br/><font point-size="9">feature behaviour</font> >]
  git [fillcolor="#feead2", label=< <b>ki-git</b><br/><font point-size="9">Governance</font><br/><font point-size="9">Git working · commit practice</font> >]
  roadmap [fillcolor="#feead2", label=< <b>ki-roadmap</b><br/><font point-size="9">Governance</font><br/><font point-size="9">forward work</font> >]
  specifications [fillcolor="#feead2", label=< <b>ki-specifications</b><br/><font point-size="9">Governance</font><br/><font point-size="9">specification repository shape</font> >]
  skills [fillcolor="#d9f0e2", label=< <b>ki-skills</b><br/><font point-size="9">Keystone</font><br/><font point-size="9">skill quality · checker contract</font> >]
  harness [fillcolor="#e0f0fc", label=< <b>ki-harness</b><br/><font point-size="9">Agentic systems</font><br/><font point-size="9">agentic-harness shape</font> >]
  kb [fillcolor="#f8dce8", label=< <b>ki-kb</b><br/><font point-size="9">Knowledge bases</font><br/><font point-size="9">knowledge-base shape</font> >]
  website [fillcolor="#e1e9fb", label=< <b>ki-website</b><br/><font point-size="9">Websites</font><br/><font point-size="9">site build</font> >]
  binding [fillcolor="#d7f2ee", label=< <b>ki-binding</b><br/><font point-size="9">Environment</font><br/><font point-size="9">portable MCP binding</font> >]
  tokenomics [fillcolor="#d7f2ee", label=< <b>ki-tokenomics</b><br/><font point-size="9">Environment</font><br/><font point-size="9">portable context policy</font> >]
  tools [fillcolor="#eee3fb", label=< <b>ki-tools</b><br/><font point-size="9">Tooling</font><br/><font point-size="9">standalone CLI</font> >]
  tap [fillcolor="#eee3fb", label=< <b>ki-homebrew-tap</b><br/><font point-size="9">Tooling</font><br/><font point-size="9">formula repository</font> >]

  // Specialisations, process capabilities, and runtime-facing skills.
  agents [fillcolor="#e0f0fc", label=< <b>ki-subagents</b><br/><font point-size="9">Agentic systems</font><br/><font point-size="9">agent quality</font> >]
  mcp [fillcolor="#e0f0fc", label=< <b>ki-mcp</b><br/><font point-size="9">Agentic systems</font><br/><font point-size="9">MCP server shape</font> >]
  plugins [fillcolor="#e0f0fc", label=< <b>ki-plugins</b><br/><font point-size="9">Agentic systems</font><br/><font point-size="9">plugin marketplace</font> >]
  kb_activities [fillcolor="#f8dce8", label=< <b>ki-kb-activities</b><br/><font point-size="9">Knowledge bases</font><br/><font point-size="9">KB activities</font> >]
  kb_artifacts [fillcolor="#f8dce8", label=< <b>ki-kb-live-artifacts</b><br/><font point-size="9">Knowledge bases</font><br/><font point-size="9">KB live artifacts</font> >]
  kb_streams [fillcolor="#f8dce8", label=< <b>ki-kb-streams</b><br/><font point-size="9">Knowledge bases</font><br/><font point-size="9">KB streams</font> >]
  cloudflare [fillcolor="#e1e9fb", label=< <b>ki-website-cloudflare</b><br/><font point-size="9">Websites</font><br/><font point-size="9">deployment</font> >]
  binding_claude [fillcolor="#d7f2ee", label=< <b>ki-binding-claude</b><br/><font point-size="9">Environment</font><br/><font point-size="9">Claude MCP adapter</font> >]
  binding_codex [fillcolor="#d7f2ee", label=< <b>ki-binding-codex</b><br/><font point-size="9">Environment</font><br/><font point-size="9">Codex MCP adapter</font> >]
  binding_chezmoi [fillcolor="#d7f2ee", label=< <b>ki-binding-chezmoi</b><br/><font point-size="9">Environment</font><br/><font point-size="9">MCP render path</font> >]
  dotfiles [fillcolor="#d7f2ee", label=< <b>ki-dotfiles-chezmoi</b><br/><font point-size="9">Environment</font><br/><font point-size="9">managed user environment</font> >]
  housekeeping_claude [fillcolor="#d7f2ee", label=< <b>ki-housekeeping-claude</b><br/><font point-size="9">Environment</font><br/><font point-size="9">Claude-state hygiene</font> >]
  tokenomics_claude [fillcolor="#d7f2ee", label=< <b>ki-tokenomics-claude</b><br/><font point-size="9">Environment</font><br/><font point-size="9">Claude context evidence</font> >]
  tokenomics_codex [fillcolor="#d7f2ee", label=< <b>ki-tokenomics-codex</b><br/><font point-size="9">Environment</font><br/><font point-size="9">Codex context evidence</font> >]
  accept [fillcolor="#e7ebf1", label=< <b>ki-accept</b><br/><font point-size="9">Process</font><br/><font point-size="9">closure · confirmed prune</font> >]
  batch [fillcolor="#e7ebf1", label=< <b>ki-batch</b><br/><font point-size="9">Process</font><br/><font point-size="9">authorised batch coordination</font> >]
  delegate [fillcolor="#e7ebf1", label=< <b>ki-delegate</b><br/><font point-size="9">Process</font><br/><font point-size="9">delegated execution support</font> >]
  implement [fillcolor="#e7ebf1", label=< <b>ki-implement</b><br/><font point-size="9">Process</font><br/><font point-size="9">bounded delivery · acceptance</font> >]
  next [fillcolor="#e7ebf1", label=< <b>ki-next</b><br/><font point-size="9">Process</font><br/><font point-size="9">next-work selection</font> >]
  plan [fillcolor="#e7ebf1", label=< <b>ki-plan</b><br/><font point-size="9">Process</font><br/><font point-size="9">planning · Ready</font> >]
  recap [fillcolor="#e7ebf1", label=< <b>ki-recap</b><br/><font point-size="9">Process</font><br/><font point-size="9">session recap</font> >]
  self [fillcolor="#fff0b8", label=< <b>ki-self</b><br/><font point-size="9">Repository-local</font><br/><font point-size="9">local governance · maintenance</font> >]

  // The runtime arms are deliberately visibly secondary: they are not skills.
  checkers [fillcolor="#edf1f5", label=< <b>checkers</b><br/><font point-size="9">Mechanical arm</font><br/><font point-size="9">audit · conform · tests</font> >, shape=component]
  native_host [fillcolor="#edf1f5", label=< <b>ki host</b><br/><font point-size="9">Mechanical arm</font><br/><font point-size="9">native rubric execution</font> >, shape=component]
  mcp_housekeeping [fillcolor="#edf1f5", label=< <b>mcp-claude-housekeeping</b><br/><font point-size="9">Mechanical arm</font><br/><font point-size="9">access-gated machine tools</font> >, shape=component]
  hooks [fillcolor="#edf1f5", label=< <b>hooks</b><br/><font point-size="9">Mechanical arm</font><br/><font point-size="9">runtime payloads</font> >, shape=component]

  // Left-to-right layers follow declared prerequisite order where an edge has
  // one. Contextual links may deliberately point across the flow.
  { rank=same; bootstrap; authoring; git }
  { rank=same; repo; dotfiles }
  { rank=same; decisions; engineering; features; roadmap; specifications; skills; agents; kb_activities; kb_artifacts; kb_streams; website; binding; tokenomics; tools; tap; housekeeping_claude; recap }
  { rank=same; harness; kb; cloudflare; binding_claude; binding_codex; binding_chezmoi; tokenomics_claude; tokenomics_codex; delegate; next; batch; self; checkers }
  { rank=same; mcp; plugins; plan; native_host; mcp_housekeeping; hooks }
  { rank=same; implement }
  { rank=same; accept }

  // Formal composition edges: a solid arrow points from the prerequisite to
  // the skill that declares it in `ki-depends-on:`. Dashed links below express
  // activation, coverage, workflow, or other contextual relationships.
  authoring -> repo [xlabel="required by"]
  git -> repo [xlabel="required by"]
  authoring -> dotfiles [xlabel="required by"]
  binding -> binding_claude [xlabel="required by"]
  binding -> binding_codex [xlabel="required by"]
  binding -> binding_chezmoi [xlabel="required by"]
  dotfiles -> binding_chezmoi
  tokenomics -> tokenomics_claude [xlabel="required by"]
  tokenomics -> tokenomics_codex
  website -> cloudflare [xlabel="required by"]
  kb_activities -> kb [xlabel="required by"]
  kb_artifacts -> kb
  kb_streams -> kb
  decisions -> harness [xlabel="required by"]
  roadmap -> harness
  skills -> harness
  agents -> harness

  bootstrap -> repo [xlabel="activates", style=dashed]

  // Repository baseline: these skills establish a repository's shared contract.
  repo -> decisions [xlabel="baseline", style=dashed]
  repo -> engineering [style=dashed]
  repo -> features [style=dashed]
  repo -> roadmap [style=dashed]
  repo -> specifications [style=dashed]
  repo -> skills [style=dashed]
  repo -> harness [style=dashed]
  repo -> kb [style=dashed]
  repo -> website [style=dashed]
  repo -> binding [style=dashed]
  repo -> tokenomics [style=dashed]
  repo -> tools [style=dashed]
  repo -> tap [style=dashed]

  // Shape and capability specialisation.
  harness -> mcp [xlabel="may contain", style=dashed]
  harness -> plugins [style=dashed]

  // Process and local-governance relationships.
  roadmap -> next [xlabel="triages"]
  next -> plan [xlabel="prepares"]
  recap -> next [xlabel="surfaces", style=dashed]
  next -> batch [style=dashed]
  batch -> plan [style=dashed]
  plan -> implement [style=dashed]
  batch -> implement [xlabel="repeats", style=dashed]
  delegate -> implement [xlabel="supports", style=dashed]
  implement -> accept [style=dashed]
  self -> skills [xlabel="promotes patterns into", style=dashed]
  housekeeping_claude -> self [xlabel="maintains", style=dashed]

  // Hosted runtime relationships.
  skills -> checkers [xlabel="governs", style=dashed]
  checkers -> native_host [xlabel="runs in", style=dashed]
  housekeeping_claude -> mcp_housekeeping [xlabel="uses", style=dashed]
  binding_claude -> hooks [xlabel="binds", style=dashed]
  binding_codex -> hooks [style=dashed]
}
